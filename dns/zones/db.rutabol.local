@       IN      SOA     ns1.rutabol.local. admin.rutabol.local. (
                              2026112101 ; Serial
                                  604800 ; Refresh
                                   86400 ; Retry
                                 2419200 ; Expire
                                   86400 ) ; Negative Cache TTL
;
@       IN      NS      ns1.rutabol.local.

ns1     IN      A       127.0.0.1
